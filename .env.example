# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Site URL (use NEXT_PUBLIC_SITE_URL in production for client-side links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000

# Sentry
NEXT_PUBLIC_SENTRY_DSN=your-project-dsn
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
DISABLE_SENTRY=false
NEXT_PUBLIC_DISABLE_SENTRY=false
SENTRY_DEBUG=false

ENABLE_CONFIRMATIONS=true

# SMTP (local: false uses Inbucket)
SMTP_ENABLED=false
SMTP_HOST=smtp.mailgun.org
SMTP_USER=example@mailgun.org
SMTP_PASS=password
SMTP_ADMIN_EMAIL=noreply@example.com
SMTP_SENDER_NAME=test_sender

MAILGUN_API_KEY=mailgun-api-key
MAILGUN_DOMAIN=team-mir.ai
MAILGUN_API_BASE_URL=https://api.mailgun.net

BATCH_ADMIN_KEY=development-admin-key-2025

# SURVEY_ENPS_POST_MISSION_ID=
# SURVEY_AWARD_POST_MISSION_ID=

LINE_CLIENT_SECRET=your-line-channel-secret
NEXT_PUBLIC_LINE_CLIENT_ID=your-line-channel-id

SLACK_WEBHOOK_URL=your-slack-webhook-url
# eNPS / 表彰は種別ごとのチャンネル用 Webhook のみ使う（SLACK_WEBHOOK_URL へはフォールバックしない）
# SLACK_WEBHOOK_URL_ENPS=https://hooks.slack.com/services/...
# SLACK_WEBHOOK_URL_AWARD=https://hooks.slack.com/services/...
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_MONITOR_CHANNEL_ID=

OWNER_USER_IDS=
OWNER_EMAILS=

# eNPSレポートの自由記述AI分析（月次バッチでのみ使用。未設定ならAI分析はスキップされる）
# OpenAI 互換の Chat Completions + JSONモードに対応していればモデル・プロバイダは問わない
# ENPS_REPORT_AI_API_KEY=
# ENPS_REPORT_AI_MODEL=gpt-4o-mini
# ENPS_REPORT_AI_BASE_URL=https://api.openai.com/v1
# temperature は既定では送らない（GPT-5系やo系の推論モデルは既定値以外で400になるため）
# ENPS_REPORT_AI_TEMPERATURE=0.2

FALLBACK_SUPPORTER_COUNT=0
