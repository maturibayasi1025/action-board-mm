{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": true,
    "maxSize": 1048576,
    "ignore": [
      "**/.next/**",
      "**/node_modules/**",
      "**/supabase/.temp/**",
      "**/playwright-report/**",
      "**/coverage/**",
      "**/.vercel/**",
      "**/terraform/**",
      "**/*.md",
      "**/*.yaml",
      "**/*.yml",
      "**/*.env*",
      "**/Dockerfile*",
      "**/.gitignore",
      "**/.dockerignore",
      "**/LICENSE*",
      "**/*.lock",
      "**/*.log",
      "**/mission_data/**",
      "**/supabase/migrations/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noExplicitAny": "warn"
      },
      "a11y": {
        "noLabelWithoutControl": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      }
    }
  },
  "overrides": [
    {
      "include": ["**/*.test.tsx", "**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noThenProperty": "off"
          }
        }
      }
    }
  ],

  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
