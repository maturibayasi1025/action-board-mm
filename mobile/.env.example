# アクションボードのWebオリジン（末尾スラッシュなし推奨）
# 例: 本番・プレビュー
# EXPO_PUBLIC_ACTION_BOARD_URL=https://action-board.example.com
#
# ローカル検証（iOSシミュレータ）: http://localhost:3000
# ローカル検証（Androidエミュレータ）: http://10.0.2.2:3000
# 実機（PCと同一LAN）: http://192.168.1.10:3000 のようにPCのIPを指定
EXPO_PUBLIC_ACTION_BOARD_URL=http://localhost:3000
