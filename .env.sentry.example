# ================================================
# Sentry設定（必須）
# ================================================
# Sentryプロジェクトから取得するDSN
# https://docs.sentry.io/platforms/javascript/guides/nextjs/
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# 環境識別子（development, staging, production）
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# ================================================
# Sentry制御設定（オプション）
# ================================================
# Sentryを完全に無効化する場合はtrueに設定
DISABLE_SENTRY=false
NEXT_PUBLIC_DISABLE_SENTRY=false

# デバッグモード（開発時のみtrue）
SENTRY_DEBUG=false

# ================================================
# Sentryの詳細設定（オプション）
# ================================================
# トレースのサンプリングレート（0.0〜1.0）
SENTRY_TRACES_SAMPLE_RATE=0.1

# リリースバージョン（自動生成も可能）
SENTRY_RELEASE=

# Sentryの組織名とプロジェクト名（ソースマップアップロード用）
SENTRY_ORG=your-organization
SENTRY_PROJECT=your-project

# Sentry認証トークン（ソースマップアップロード用）
SENTRY_AUTH_TOKEN=

# ================================================
# 取得方法
# ================================================
# 1. Sentryアカウントにログイン: https://sentry.io
# 2. プロジェクトを作成または選択
# 3. Settings > Projects > [Your Project] > Client Keys (DSN)
# 4. DSNをコピーしてNEXT_PUBLIC_SENTRY_DSNに設定
# 
# ソースマップアップロード（本番環境で推奨）:
# 1. Settings > Account > API > Auth Tokens
# 2. "Create New Token"をクリック
# 3. Scopesで以下を選択:
#    - project:releases (create/edit/delete releases)
#    - org:read (read org details)
# 4. トークンをSENTRY_AUTH_TOKENに設定